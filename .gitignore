# ===== 용량이 큰 파일 (GitHub는 100MB 넘는 파일을 받지 않음) =====
# YOLO 모델 가중치 (실행하면 자동으로 다시 다운로드됨)
*.pt
*.pth
*.onnx

# 영상 파일
*.mp4
*.avi
*.mov
*.mkv
*.wmv

# ===== 실행 결과물 (코드를 다시 실행하면 생성됨) =====
runs/

# ===== 파이썬 자동 생성 파일 =====
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ===== 가상환경 =====
venv/
.venv/
env/

# ===== 비밀 정보 (API 키 등) =====
.env
*.env

# ===== OS 자동 생성 파일 =====
Thumbs.db
desktop.ini
.DS_Store
